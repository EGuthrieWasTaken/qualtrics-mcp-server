# Qualtrics API Configuration
# Note: `docker run --env-file` is not dotenv. It does not strip quotes or
# inline comments, so keep values unquoted and put comments on their own line.
QUALTRICS_API_TOKEN=your_api_token_here
QUALTRICS_DATA_CENTER=yourdatacenterid

# Optional: Custom Base URL (if using a different Qualtrics instance)
# QUALTRICS_BASE_URL=https://custom.qualtrics.com/API/v3

# Optional: Directory for large response exports (default: ~/Downloads).
# The Docker image sets this to /home/node/Downloads.
# QUALTRICS_EXPORT_DIR=/path/to/exports

# Server Configuration
# Block all write/delete operations (safe exploration mode)
# QUALTRICS_READ_ONLY=true
# Scopes enabled at startup in every session (comma-separated). Overrides QUALTRICS_READ_ONLY.
# QUALTRICS_WRITE_SCOPES=questionsAndBlocks,surveyDesign
# Make that list a ceiling that clients cannot raise with set_write_scopes.
# QUALTRICS_WRITE_SCOPES_LOCKED=true
RATE_LIMITING_ENABLED=true
RATE_LIMIT_RPM=50
REQUEST_TIMEOUT=30000

# Optional: Streamable HTTP entrypoint (pnpm start:http / Docker). See README.
# Credentials: set MCP_AUTH_TOKEN, the CF_ACCESS_* pair, or both (either is accepted).
# At least one is required unless bound to 127.0.0.1.
# API key, sent by clients as X-API-Key or Authorization: Bearer.
# Generate one with: openssl rand -hex 32
# MCP_AUTH_TOKEN=
# Cloudflare Access: set both. The token is verified against your team's keys.
# CF_ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com
# CF_ACCESS_AUD=
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3000
# MCP_ALLOWED_HOSTS=mcp.example.com
